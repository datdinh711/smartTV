{
  "name": "smart-tv",
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:mobile": "ng build && npx cap sync",
    "generate:assets": "npx @capacitor/assets generate --android --assetPath src/assets/android-app-icons",
    "android": "npx cap open android",
    "run:android": "npm run build:mobile && npx cap run android",
    "sync": "npx cap sync",
    "build:apk:debug": "npm run build:mobile && cd android && gradlew assembleDebug",
    "build:apk:release": "ng build --configuration production && npx cap sync && cd android && gradlew assembleRelease",
    "build:apk": "npm run build:apk:debug",
    "install:apk": "adb install android/app/build/outputs/apk/debug/app-debug.apk",
    "launch:app": "adb shell am start -n com.example.smarttv/com.example.smarttv.MainActivity",
    "test:apk": "npm run build:apk && npm run install:apk && npm run launch:app",
    "build:tizen": "node scripts/build-tizen-bundle.js",
    "electron:build": "ng build --configuration electron && electron-builder --dir",
    "electron:build:exe": "ng build --configuration electron && electron-builder --win",
    "electron:build:portable": "ng build --configuration electron && electron-builder --win portable",
    "electron:start": "ng build --configuration development --base-href ./ && electron ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^8.1.0",
    "@ionic/angular": "^8.7.17",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "angularx-qrcode": "^17.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.6",
    "@angular/cli": "^17.3.6",
    "@angular/compiler-cli": "^17.3.0",
    "@capacitor/assets": "^3.0.5",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.8",
    "typescript": "~5.4.2"
  },
  "build": {
    "appId": "com.example.smarttv",
    "productName": "SmartTV",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/smart-tv/browser/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/images/app_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "SmartTV-portable.exe"
    }
  }
}